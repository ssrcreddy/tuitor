# Copy to .env.local. For local dev, `npx supabase status` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Used for payments, refunds and payouts (bypasses RLS).
# (SUPABASE_SERVICE_ROLE_KEY above.)

# Stripe (use test-mode keys: sk_test_...). Locally, STRIPE_WEBHOOK_SECRET is
# printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared secret for the daily cron job (Vercel sends it as a Bearer token).
CRON_SECRET=

# Later phases
DAILY_API_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
